# ==============================================================
#  Kit de Vídeo para YouTube — plantilla de configuración
# ==============================================================
#  1. Copia este archivo a `.env`   ->   cp .env.example .env
#  2. Rellena SOLO las claves que vayas a usar.
#  3. NUNCA subas `.env` a Git (ya está en .gitignore).
#
#  Forma recomendada de rellenarlo:  python3 scripts/setup.py
#  (asistente interactivo, oculta las claves al escribirlas)
# ==============================================================


# --------------------------------------------------------------
#  OBLIGATORIO: Gemini / Google AI Studio
# --------------------------------------------------------------
#  Es el único proveedor que analiza vídeo completo y acepta
#  URLs de YouTube de forma nativa. Sin esta clave el kit no
#  puede investigar vídeos.
#
#  Consíguela gratis en:  https://aistudio.google.com/apikey
# --------------------------------------------------------------
GEMINI_API_KEY=

# Modelos (opcional). Si los dejas vacíos, el kit descubre los
# disponibles en tu cuenta con:  python3 scripts/models.py
GEMINI_TEXT_MODEL=
GEMINI_VIDEO_MODEL=
GEMINI_IMAGE_MODEL=


# --------------------------------------------------------------
#  OPCIONAL: OpenRouter
# --------------------------------------------------------------
#  Útil solo para tareas de TEXTO (ángulos, ganchos, títulos, SEO)
#  si prefieres otro modelo o quieres un respaldo.
#  NO sirve para analizar vídeo ni URLs de YouTube.
#
#  Consíguela en:  https://openrouter.ai/keys
# --------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=


# --------------------------------------------------------------
#  OPCIONAL: Higgsfield (generación de miniaturas)
# --------------------------------------------------------------
#  API oficial: https://cloud.higgsfield.ai  (docs.higgsfield.ai)
#  Se usan los mismos nombres de variable que el SDK oficial.
#  Alternativa: deja esto vacío y usa Gemini para las miniaturas.
#
#  Consíguelas en:  https://cloud.higgsfield.ai/
# --------------------------------------------------------------
HF_API_KEY=
HF_API_SECRET=

# Ruta de la "application" de Higgsfield que quieras usar.
# Cópiala EXACTAMENTE de la página del modelo en cloud.higgsfield.ai.
# Ejemplo verificado en el SDK oficial:
#   bytedance/seedream/v4/text-to-image
HIGGSFIELD_TEXT_TO_IMAGE_APP=bytedance/seedream/v4/text-to-image
# Para editar/usar tu foto como referencia (déjalo vacío si no sabes cuál es):
HIGGSFIELD_IMAGE_EDIT_APP=


# --------------------------------------------------------------
#  Límites de gasto (protección)
# --------------------------------------------------------------
# Nº máximo de imágenes que se pueden generar en una sola orden
MAX_IMAGES_PER_RUN=3
# Pide confirmación antes de cualquier operación de pago (1 = sí)
CONFIRM_PAID_ACTIONS=1

# Nombre del parámetro de imagen de entrada del modelo de Higgsfield
# (solo si usas referencia y el modelo espera otro nombre, p. ej. "input_image_url").
HIGGSFIELD_IMAGE_PARAM=image_url
