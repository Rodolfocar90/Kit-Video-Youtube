# ==============================================================
#  RELLENA SOLO ESTA LÍNEA. TODO LO DEMÁS SE QUEDA VACÍO.
# ==============================================================
#
#  Busca más abajo la línea que acaba en "=" y pega tu clave
#  justo detrás, sin espacios y sin comillas. Nada más.
#
#  ¿No tienes clave? Es gratis y tarda un minuto:
#      https://aistudio.google.com/apikey   ->  "Create API key"
#
#  OJO: la línea de verdad es la única que NO empieza por #

GEMINI_API_KEY=

# ==============================================================
#  A PARTIR DE AQUÍ: TODO OPCIONAL. NO HACE FALTA TOCAR NADA.
# ==============================================================
#  Deja estas líneas vacías y el kit funciona igual. No borres
#  nada: lo que está en blanco simplemente se ignora.
#
#  (Las líneas que empiezan por # son comentarios para ti.
#   El programa no las lee.)
# ==============================================================


# --- Modelos de Gemini -----------------------------------------
# Vacío = el kit detecta solo los mejores de tu cuenta.
# Rellena solo si quieres forzar uno concreto (p. ej. un "flash"
# para gastar menos en vídeos largos).
GEMINI_TEXT_MODEL=
GEMINI_VIDEO_MODEL=
GEMINI_IMAGE_MODEL=


# --- OpenRouter ------------------------------------------------
# Otro proveedor, solo para texto. NO analiza vídeo ni URLs de
# YouTube, así que no sustituye a Gemini.
# Clave en: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=


# --- Higgsfield ------------------------------------------------
# Segundo generador de imágenes. No hace falta: Gemini ya crea
# miniaturas 16:9 con tu foto de referencia.
# Claves en: https://cloud.higgsfield.ai/  (solo se ven al crearlas)
HF_API_KEY=
HF_API_SECRET=

# Ruta del modelo de Higgsfield. Cópiala tal cual de la página del
# modelo en cloud.higgsfield.ai. Solo importa si usas Higgsfield.
HIGGSFIELD_TEXT_TO_IMAGE_APP=bytedance/seedream/v4/text-to-image
# Para usar tu foto como referencia con Higgsfield:
HIGGSFIELD_IMAGE_EDIT_APP=
HIGGSFIELD_IMAGE_PARAM=image_url


# --- Límites de gasto ------------------------------------------
# Déjalos así salvo que sepas lo que haces.
# Máximo de imágenes que se generan de una sola vez:
MAX_IMAGES_PER_RUN=3
# Pedir confirmación antes de cualquier cosa que cueste dinero:
CONFIRM_PAID_ACTIONS=1
