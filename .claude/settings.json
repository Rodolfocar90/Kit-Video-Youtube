{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 scripts/setup.py:*)",
      "Bash(python3 scripts/doctor.py:*)",
      "Bash(python3 scripts/models.py:*)",
      "Bash(python3 scripts/new_project.py:*)",
      "Bash(python3 scripts/analyze.py:*)",
      "Bash(python3 scripts/web_research.py:*)",
      "Bash(python3 scripts/build_pack.py:*)",
      "Bash(ls:*)",
      "Bash(cat input/*)",
      "Read(input/**)",
      "Read(output/**)",
      "Read(config/**)",
      "Write(output/**)",
      "Edit(output/**)",
      "Bash(pip3 install -r requirements.txt)",
      "Bash(cp:*)",
      "Bash(mkdir -p input/*)",
      "Write(input/REFERENCIAS.md)",
      "Edit(input/REFERENCIAS.md)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Write(.env)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(echo $GEMINI_API_KEY)",
      "Bash(grep:* .env)"
    ]
  }
}
